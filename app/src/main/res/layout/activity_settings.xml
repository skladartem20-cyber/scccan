<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Язык -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SectionTitle" android:text="@string/language" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/lang_ru"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_ru"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/lang_zh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_zh"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Режим сканера -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="@string/scanner_mode" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/mode_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_keyboard"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/mode_keyboard_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="6dp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/mode_broadcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_broadcast"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/mode_broadcast_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- параметры broadcast -->
            <LinearLayout
                android:id="@+id/broadcast_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="@string/broadcast_action" />
                <EditText
                    android:id="@+id/bc_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

                <TextView style="@style/FieldLabel" android:text="@string/broadcast_extra" />
                <EditText
                    android:id="@+id/bc_extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/save" />
            </LinearLayout>
        </LinearLayout>

        <!-- Звук и вибрация -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="@string/feedback" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_vibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vibrate"
                android:textSize="15sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sound_on_scan"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- О приложении -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="@string/about" />

            <TextView
                android:id="@+id/about_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
