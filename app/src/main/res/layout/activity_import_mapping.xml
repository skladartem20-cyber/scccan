<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView style="@style/FieldLabel" android:text="@string/sheet_label" />
            <Spinner
                android:id="@+id/sheet_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/FieldLabel" android:text="@string/header_row" />
            <Spinner
                android:id="@+id/header_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/FieldLabel" android:text="@string/barcode_col" />
            <Spinner
                android:id="@+id/bc_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/FieldLabel" android:text="@string/name_col" />
            <Spinner
                android:id="@+id/name_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/FieldLabel" android:text="@string/article_col" />
            <Spinner
                android:id="@+id/art_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/rows_detected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/primary_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/preview" />

            <TextView
                android:id="@+id/preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <TextView style="@style/FieldLabel" android:text="@string/store_name_hint" />
            <EditText
                android:id="@+id/store_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/store_name_hint"
                android:inputType="text" />

            <TextView style="@style/FieldLabel" android:text="@string/store_note_hint" />
            <EditText
                android:id="@+id/store_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/store_note_hint"
                android:inputType="text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/PrimaryButton"
                android:layout_marginTop="18dp"
                android:text="@string/save_store" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
